{
  "name": "07 GET scan results",
  "request": {
    "type": "http",
    "url": "{{base_url}}/api/v1/scans/{{scan_id}}/results",
    "scripts": {
      "preRequest": "",
      "postResponse": "pm.test('status 200', function () { pm.response.to.have.status(200); });\npm.test('results array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
    },
    "method": "GET",
    "queryParams": [
