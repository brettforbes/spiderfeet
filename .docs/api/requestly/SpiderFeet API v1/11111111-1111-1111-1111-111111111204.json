      },
      {
        "id": 2,
        "key": "filter_fp",
        "value": "false",
        "isEnabled": true
      }
    ],
    "headers": [],
    "body": null,
    "contentType": "text/plain",
    "auth": {
      "currentAuthType": "INHERIT",
      "authConfigStore": {}
    }
  }
}
