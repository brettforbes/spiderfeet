{
  "schema_version": 1,
  "description": "Maps subscription providers to SpiderFeet module opts and external CLI app environment variables.",
  "cli_apps": {
    "pius": {
      "display_name": "Pius",
      "default_binary_path": ".tools/pius",
      "default_env_file": ".tools/pius.env",
      "runtime": "wsl",
      "enabled": true
    },
    "nmap": {
      "display_name": "Nmap",
      "default_binary_path": "nmap",
      "default_env_file": null,
      "runtime": "windows",
      "enabled": true
    },
    "nerva": {
      "display_name": "Nerva",
      "default_binary_path": ".tools/bin/nerva.exe",
      "default_env_file": null,
      "runtime": "windows",
      "enabled": true
    },
    "netdiscover": {
      "display_name": "Netdiscover",
      "default_binary_path": "netdiscover",
      "default_env_file": null,
      "runtime": "wsl-root",
      "enabled": true
    }
  },
  "providers": [
    {
      "provider_id": "sfp_shodan",
      "kind": "shared",
      "name": "SHODAN",
      "spiderfeet_module_id": "sfp_shodan",
      "cli_apps": ["pius"],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "SHODAN_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "sfp_securitytrails",
      "kind": "shared",
      "name": "SecurityTrails",
      "spiderfeet_module_id": "sfp_securitytrails",
      "cli_apps": ["pius"],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "SECURITYTRAILS_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "sfp_censys",
      "kind": "shared",
      "name": "Censys",
      "spiderfeet_module_id": "sfp_censys",
      "cli_apps": ["pius"],
      "secret_fields": [
        {"opt": "censys_api_key_uid", "label": "API UID"},
        {"opt": "censys_api_key_secret", "label": "API Secret"}
      ],
      "env_mappings": [
        {"cli_app": "pius", "env_var": "CENSYS_ORG_ID", "from_opt": "censys_api_key_uid"},
        {"cli_app": "pius", "env_var": "CENSYS_API_TOKEN", "from_opt": "censys_api_key_secret"}
      ]
    },
    {
      "provider_id": "sfp_builtwith",
      "kind": "shared",
      "name": "BuiltWith",
      "spiderfeet_module_id": "sfp_builtwith",
      "cli_apps": ["pius"],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "BUILTWITH_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "sfp_whoxy",
      "kind": "shared",
      "name": "Whoxy",
      "spiderfeet_module_id": "sfp_whoxy",
      "cli_apps": ["pius"],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "WHOXY_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "sfp_binaryedge",
      "kind": "shared",
      "name": "BinaryEdge",
      "spiderfeet_module_id": "sfp_binaryedge",
      "cli_apps": ["pius"],
      "secret_fields": [{"opt": "binaryedge_api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "BINARYEDGE_API_KEY", "from_opt": "binaryedge_api_key"}]
    },
    {
      "provider_id": "cli_pius_apollo",
      "kind": "cli_only",
      "name": "Apollo.io (Pius)",
      "cli_apps": ["pius"],
      "subscription_tier": "free_auth",
      "signup_url": "https://www.apollo.io/",
      "signup_bucket": "review",
      "signup_note": "Apollo.io API — confirm free tier on site.",
      "website": "https://www.apollo.io/",
      "api_key_instructions": [
        "Visit https://www.apollo.io/",
        "Create an account and open API settings",
        "Generate an API key and paste it below"
      ],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "APOLLO_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "cli_pius_viewdns",
      "kind": "cli_only",
      "name": "ViewDNS (Pius)",
      "cli_apps": ["pius"],
      "subscription_tier": "free_auth",
      "signup_url": "https://viewdns.info/",
      "signup_bucket": "review",
      "signup_note": "ViewDNS API key for reverse-whois / reverse-ip plugins.",
      "website": "https://viewdns.info/",
      "api_key_instructions": [
        "Visit https://viewdns.info/",
        "Register and obtain an API key from your account",
        "Paste the key below"
      ],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "VIEWDNS_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "cli_pius_fofa",
      "kind": "cli_only",
      "name": "FOFA (Pius)",
      "cli_apps": ["pius"],
      "subscription_tier": "free_auth",
      "signup_url": "https://fofa.info/",
      "signup_bucket": "review",
      "signup_note": "FOFA API for favicon-hash plugin.",
      "website": "https://fofa.info/",
      "api_key_instructions": [
        "Visit https://fofa.info/",
        "Register and copy email + API key from account settings",
        "Paste the API key below"
      ],
      "secret_fields": [{"opt": "api_key", "label": "API key"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "FOFA_API_KEY", "from_opt": "api_key"}]
    },
    {
      "provider_id": "cli_pius_github",
      "kind": "cli_only",
      "name": "GitHub Token (Pius)",
      "cli_apps": ["pius"],
      "subscription_tier": "free_auth",
      "signup_url": "https://github.com/settings/tokens",
      "signup_bucket": "self-serve",
      "signup_note": "Personal access token for Pius github-org plugin (optional rate-limit headroom).",
      "website": "https://github.com/",
      "api_key_instructions": [
        "Visit https://github.com/settings/tokens",
        "Generate a fine-grained or classic token with read access to public repos/orgs",
        "Paste the token below"
      ],
      "secret_fields": [{"opt": "api_key", "label": "Token"}],
      "env_mappings": [{"cli_app": "pius", "env_var": "GITHUB_TOKEN", "from_opt": "api_key"}]
    }
  ]
}
