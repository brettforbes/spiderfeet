	# Data Nuggets
	# DATA - raw or structured payload blobs (WHOIS, banners, headers, etc.)

	entity affiliate-domain-whois, sub nugget;  # Affiliate - Domain Whois
	entity affiliate-web-content, sub nugget;  # Affiliate - Web Content
	entity base64-data, sub nugget;  # Base64-encoded Data
