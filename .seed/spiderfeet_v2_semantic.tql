	##########################################
	# Updated to v2 OSINT Service Definitions
	##########################################

	relation sfp-cli-app-nmap, sub osint-service;
	relation sfp-cli-app-nuclei, sub osint-service;
	relation sfp-cli-app-httpx, sub osint-service;
	relation sfp-cli-app-netdiscover, sub osint-service;
	relation sfp-cli-app-nerva, sub osint-service;
	relation sfp-cli-app-pius, sub osint-service;
	relation sfp-cli-app-subfinder, sub osint-service;
	relation sfp-cli-app-katana, sub osint-service;
	
	#####################################
	# SpiderFeet Route Relation Definitions
	####################################

	# Route state is in-test, until proven by tests to be either "favourite", 
	#       "unique", "error", or "dominated" by another route.
	
	relation route,
		owns route_name,
		owns route_state,
		relates osint-service,
		relates consumed @card(0..),
		relates produced @card(0..),
		plays sequence:prior,
		plays sequence:next,
		plays scan_step:route; # v2 scan relation is scan_step (entity scan-record is the SCAN_RECORD nugget type)

	relation sequence,
		owns sequence_name,
		relates prior,
		relates next;


	#####################################
	# SpiderFeet Scan Relation Definitions
	#
	# One scan per module invocation (scan_ui / UI workflow). Owns instance
	# metadata and result summary; links consumed/produced nuggets, the osint-service
	# that ran (service role), and the route under test (route role).
	#
	# API / UI parity (POST /api/v1/scan_ui scan_record):
	#   scan_instance_id   — SpiderFeet scan id (e.g. CFA30507)
	#   scan_status        — lifecycle: STARTING, FINISHED, ERROR-FAILED, …
	#   scan_duration      — seconds (started → ended)
	#   scan_timestamp     — scan start (datetime)
	#   scan_notes         — operator / UI notes
	#   scan_nugget_count   — total events in this scan instance
	#   scan_results_by_type — object map event_type → count (e.g. IP_ADDRESS: 2)
	#   scan_results       — bundled summary object { status, event_count, by_type }
	#   service (role)     — osint-service: module_id, name (e.g. sfp_dnsresolve)
	#   route (role)       — route: route_name, route_state (e.g. in-test)
	#   consumed / produced (roles) — nugget instances
	####################################

	relation scan_step, # the record generated as a result of a single scan instance, including ui data and scan results
		owns scan_instance_id @key, # e.g. "scan_step--1c51e712-b5b5-4ef2-9967-e11debbcc607"
		owns step_module_id, # name of the step's module, e.g. "sfp_cli_subfinder" (avoid bare attribute label `id`)
		owns scan_status, # success, error, etc.
		owns scan_nugget_count, # number of nuggets generated by this scan instance,
		owns scan_results_by_type, # object map event_type → count (e.g. IP_ADDRESS: 2)
		owns scan_results, # bundled summary object { status, nugget_count, by_type }
		owns scan_duration, # time scan took to complete
		owns scan_timestamp, # time scan started (API / UI parity)
		owns scan_notes,
		owns scan_ui_cli_command, # the command run to execute the scan step, e.g. "subfinder -d example.com -o json"
		owns scan_ui_text_form, # text description of the scan step,
		owns scan_ui_structured_form, # structured form of the scan step as a string, e.g. { json, csv, xml, etc. }
		owns scan_ui_structured_form_type, # type of the structured form, e.g. "json", "csv", "xml", etc.
		owns scan_ui_graph_form, # json string form of the nodes and edges arrays of the semantic scan subgraph
		owns scan_ui_markdown_narrative_form, # markdown string form of the narrative description of the scan step
		owns scan_yaml, # description in yaml workflow DSL, e.g. "subfinder_enum"
		plays workflow:prior_step, # step can be a prior step in a sequence of steps
		plays workflow:first_step, # step can be the first step in a sequence of steps
		plays workflow:next_step, # step can be a next step in a sequence of steps
		relates consumed @card(0..), # nugget inputs consumed by this scan step
		plays scan_result_graph:scan_step,  # contains actual nodes and edges arrays for the scan result
		relates service, # native osint-service: module_id, name (e.g. sfp_cli_nmap)
		relates route @card(0..1); # route under test when this step ran

		
	relation workflow,
		owns workflow_id @key, # e.g. "workflow--1c51e712-b5b5-4ef2-9967-e11debbcc607"
		owns name, # name of the workflow, e.g. "recon_attack_surface"
		owns description, # description of the workflow, e.g. "Enumerate domains, map ports/services, and map live web surface + vulns. Ports/services chain and web/vuln chain share sfp_cli_subfinder, then fan out."
		owns author, # author of the workflow, e.g. "Modeller"
		owns created, # time workflow was created
		owns workflow_yaml, # string description in yaml workflow DSL, to feed to the workflow iFrame widget
		relates first_step,
		relates prior_step,
		relates next_step,
		relates target,
		plays project:workflow;

	entity target,
		owns target_id @key, # e.g. "target--1c51e712-b5b5-4ef2-9967-e11debbcc607"
		owns target_value, # value of the target, e.g. "example.com"
		owns target_description, # description of the target, e.g. "The target domain to scan"
		owns target_created, # time target was created
		owns target_yaml, # string description in yaml target DSL, to feed to the target iFrame widget
		plays target_context:target;

	#####################################
	# SpiderFeet User-Initiated Project, includes a Workflow of scans and a Context
	#
	# A user-initiated project includes a workflow of individual scan steps, and a Context 
	# each step comprised of inputs, scan config, produces a context subgraph (nodes and edges arrays), and outputs (defined variables)
	# The overall workflow may have a Target, and steps can use the target or output variables as inputs
	# Steps have a binary variable whether to output semantic scan subgraphs, as nodes and edges arrays, into
	####################################

	relation project,
		owns project_id @key, # e.g. "project--1c51e712-b5b5-4ef2-9967-e11debbcc607"
		owns stix_incident_id @card(0..1), # e.g. "incident--1c51e712-b5b5-4ef2-9967-e11debbcc607"
		owns created,
		relates workflow @card(0..),
		plays project_context:project, # contains actual nodes and edges arrays for the context for the project
		plays temporary_subgraph:project; # contains actual nodes and edges arrays as the temporary subgraph for the project


	#####################################
	# SpiderFeet Attribute Definitions
	# (only attributes referenced by owns on entity/relation types)
	####################################

	attribute route_state, value string @values("in-test", "favourite", "unique", "error", "dominated");
	attribute service_origin, value string @values("external-api", "cli", "local");
	attribute service_state, value string @values("quarantine", "in-test", "favourite", "unique", "error", "dominated");
	attribute fixture_category, value string @values("positive", "negative");
	attribute route_name, value string;
	attribute sequence_name, value string;
	attribute access_tier, value string @values("free_no_auth", "free_auth", "paid");
	attribute consumption_group, value string @values("domain", "hostname", "domain_and_hostname", "ip_netblock", "ip_only", "email", "email_identity_bundle", "phone", "crypto", "web_url_content", "org_entity", "other");
	attribute route_seed_nugget, value string;
	attribute module_id, value string;
	attribute name, value string;
	attribute summary, value string;
	attribute flags, value string;
	attribute use_cases, value string;
	attribute categories, value string;
	attribute consumed_nuggets, value string;
	attribute produced_nuggets, value string;
	attribute website, value string;
	attribute model, value string;
	attribute references, value string;
	attribute api_key_instructions, value string;
	attribute fav_icon, value string;
	attribute logo, value string;
	attribute description, value string;
	attribute author, value string;
	attribute markdown_graph_structure_string, value string;
	attribute markdown_options_string, value string;
	attribute markdown_zero_to_hero_string, value string;
	attribute nugget_id, value string;
	attribute nugget_instance_id, value string;
	attribute nugget_description, value string;
	attribute nugget_type, value string;
	attribute nugget_event_type, value string;
	attribute nugget_icon, value string;
	attribute nugget_colour, value string;
	attribute nugget_data, value string;
	attribute nugget_source_data, value string;
	attribute nugget_module, value string;
	attribute nugget_generated, value integer;
	attribute nugget_confidence, value integer;
	attribute nugget_visibility, value integer;
	attribute nugget_risk, value integer;
	attribute nugget_false_positive, value boolean;
	attribute opt_name, value string;
	attribute in_value, value integer;
	attribute db_value, value double;
	attribute bo_value, value boolean;
	attribute st_value, value string;
	attribute scan_result_id, value string;
	attribute project_context_id, value string;
	attribute temporary_subgraph_id, value string;
	attribute scan_instance_id, value string;
	attribute step_module_id, value string;
	attribute scan_status, value string @values("STARTING", "RUNNING", "FINISHED", "ERROR-FAILED", "ABORTED", "ABORT-REQUESTED", "UNKNOWN");
	attribute scan_nugget_count, value integer;
	attribute scan_results_by_type, value string;
	attribute scan_results, value string;
	attribute scan_duration, value double;
	attribute scan_timestamp, value datetime;
	attribute scan_notes, value string;
	attribute scan_ui_cli_command, value string;
	attribute scan_ui_text_form, value string;
	attribute scan_ui_structured_form, value string;
	attribute scan_ui_structured_form_type, value string;
	attribute scan_ui_graph_form, value string;
	attribute scan_ui_markdown_narrative_form, value string;
	attribute scan_yaml, value string;
	attribute workflow_id, value string;
	attribute workflow_yaml, value string;
	attribute project_id, value string;
	attribute stix_incident_id, value string;
	attribute created, value datetime;

	#####################################
	# Schema functions (containment walk)
	# has_this ≈ ontology "had" (has is reserved); contains_this ≈ "contains";
	# listens_to_this ≈ "listens-to". Roles remain semantic_link source/target.
	####################################

	fun contains_recursive($container_A: nugget) -> { nugget }:
	match
	  {
	    $_ isa contains_this,
	      links (source: $container_A, target: $contained_C);
	  } or {
	    let $intermediate_B in contains_recursive($container_A);
	    $_ isa contains_this,
	      links (source: $intermediate_B, target: $contained_C);
	  };
	return { $contained_C };