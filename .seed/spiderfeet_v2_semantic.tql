	entity dns-srv, sub nugget;  # DNS SRV Record
	entity dns-text, sub nugget;  # DNS TXT Record
	entity domain-whois, sub nugget;  # Domain Whois
	entity error-message, sub nugget;  # Error Message
	entity hash, sub nugget;  # Hash
	entity hash-compromised, sub nugget;  # Compromised Password Hash
	entity http-code, sub nugget;  # HTTP Status Code
	entity leaksite-content, sub nugget;  # Leak Site Content
	entity netblock-whois, sub nugget;  # Netblock Whois
	entity password-compromised, sub nugget;  # Compromised Password
	entity pgp-key, sub nugget;  # PGP Public Key
	entity raw-dns-records, sub nugget;  # Raw DNS Records
	entity raw-file-meta-data, sub nugget;  # Raw File Meta Data
	entity raw-rir-data, sub nugget;  # Raw Data from RIRs/APIs
	entity search-engine-web-content, sub nugget;  # Search Engine Web Content
	entity similardomain-whois, sub nugget;  # Similar Domain - Whois
	entity ssl-certificate-raw, sub nugget;  # SSL Certificate - Raw Data
	entity target-web-content, sub nugget;  # Web Content
	entity target-web-cookie, sub nugget;  # Cookies
	entity tcp-port-open-banner, sub nugget;  # Open TCP Port Banner
	entity udp-port-open-info, sub nugget;  # Open UDP Port Information
	entity webserver-banner, sub nugget;  # Web Server
	entity webserver-httpheaders, sub nugget;  # HTTP Headers
	entity webserver-strangeheader, sub nugget;  # Non-Standard HTTP Header

	# Subentity Nuggets
	# SUBENTITY - child objects owned by a parent entity (ports, URLs, software)

	entity port, sub subentity_nugget; # Network Port
	entity trace-hop, sub subentity_nugget; # Trace Hop
	entity cpe-url, sub subentity_nugget; # CPE URL
	entity ssh-key @abstract, sub subentity_nugget; # SSH Key
	entity dsa, sub ssh-key; # SSH Key - DSA
	entity rsa, sub ssh-key; # SSH Key - RSA
	entity ecdsa, sub ssh-key; # SSH Key - ECDSA
	entity eddsa, sub ssh-key; # SSH Key - EdDSA
	entity linked-url-external, sub nugget;  # Linked URL - External
	entity linked-url-internal, sub nugget;  # Linked URL - Internal
	entity software-used, sub nugget;  # Software Used
	entity tcp-port-open, sub nugget;  # Open TCP Port
	entity udp-port-open, sub nugget;  # Open UDP Port

	#####################################
	# SpiderFeet OSINT Service Definitions
	####################################

	relation osint-service,
		owns module_id,
		owns name,
		owns summary,
		owns flags,
		owns use_cases,
		owns categories,
		owns fixture_category,
		owns access_tier,
		owns consumption_group,
		owns route_seed_nugget,
		owns consumed_nuggets,
		owns produced_nuggets,
		owns service_state,
		owns service_origin,
		owns markdown_graph_structure_string, # String containing the Graph Structure doc for this service
		owns markdown_options_string, # String containing the Markdown options for this service
		owns markdown_zero_to_hero_string, # String containing the Zero to Hero doc for this service
		plays scan_step:service,
		plays data-source:service,
		plays route:osint-service,
		plays opts:service,
		relates consumed @card(0..),
		relates produced @card(0..);

	entity osint-source,
		owns website,
		owns model,
		owns references,
		owns api_key_instructions,
		owns fav_icon,
		owns logo,
		owns description,
		plays data-source:source;

	entity module-opt,
		owns opt_name,
		owns in_value @card(0..1),
		owns db_value @card(0..1),
		owns bo_value @card(0..1),
		owns st_value @card(0..1),
		owns description @card(0..1),
		plays opts:opt;

	relation opts,
		relates service,
		relates opt;

	relation data-source,
		relates service,
		relates source;

