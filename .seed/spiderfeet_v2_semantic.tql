	entity url-java-applet, sub nugget;  # URL (Uses Java Applet)
	entity url-java-applet-historic, sub nugget;  # Historic URL (Uses Java Applet)
	entity url-javascript, sub nugget;  # URL (Uses Javascript)
	entity url-javascript-historic, sub nugget;  # Historic URL (Uses Javascript)
	entity url-password, sub nugget;  # URL (Accepts Passwords)
	entity url-password-historic, sub nugget;  # Historic URL (Accepts Passwords)
	entity url-static, sub nugget;  # URL (Purely Static)
	entity url-static-historic, sub nugget;  # Historic URL (Purely Static)
	entity url-upload, sub nugget;  # URL (Accepts Uploads)
	entity url-upload-historic, sub nugget;  # Historic URL (Accepts Uploads)
	entity url-web-framework, sub nugget;  # URL (Uses a Web Framework)
	entity url-web-framework-historic, sub nugget;  # Historic URL (Uses a Web Framework)
