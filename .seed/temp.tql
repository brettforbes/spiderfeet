define

	# Naming convention (Option B):
	#   Entity and relation type labels: kebab-case (e.g. osint-service, domain-name)
	#   Attribute type labels: snake_case (e.g. access_tier, module_id)
	#   @values string literals: snake_case data values (e.g. free_no_auth, ip_netblock)

	####################################
	# SpiderFeet Nugget Definitions
	#
	# Archetype nuggets (from nuggets.json): nugget_id, nugget_description,
	# nugget_type (ENTITY/DATA/DESCRIPTOR/INTERNAL), nugget_icon, nugget_colour.
	#
	# Live / scan-instance nuggets (from SpiderFeet scan results) also populate:
	#   nugget_instance_id @key, nugget_data, nugget_source_data, nugget_module,
	#   nugget_event_type (e.g. INTERNET_NAME), nugget_generated (unix seconds),
	#   nugget_confidence, nugget_visibility, nugget_risk, nugget_false_positive.
	#   nugget_description holds event_description when present (e.g. "Internet Name").
	####################################

	entity nugget @abstract,
		owns nugget_id,
		owns nugget_instance_id @key,
		owns nugget_description,
		owns nugget_type,
		owns nugget_event_type,
		owns nugget_icon,
		owns nugget_colour,
		owns nugget_data,
		owns nugget_source_data,
		owns nugget_module,
		owns nugget_generated,
		owns nugget_confidence,
		owns nugget_visibility,
		owns nugget_risk,
		owns nugget_false_positive,
		plays osint-service:consumed,
		plays osint-service:produced,
		plays route:consumed,
		plays route:produced,
		plays scan-record:consumed,
		plays scan-record:produced;

	entity root, sub nugget;
	entity account-external-owned, sub nugget;
