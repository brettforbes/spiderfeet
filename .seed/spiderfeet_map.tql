	#####################################
	# SpiderFeet Route Relation Definitions
	####################################

	# Route state is in-test, until proven by tests to be either "favourite", 
	#       "unique", "error", or "dominated" by another route.
	relation route,
		owns route_name,
		owns route_state,
		relates osint-service,
		relates consumed @card(0..),
		relates produced @card(0..),
		plays sequence:prior,
		plays sequence:next,
		plays scan-record:route;

	relation sequence,
		owns sequence_name,
		relates prior,
		relates next;

	#####################################
	# SpiderFeet Scan Record Relation Definitions
	#
	# One scan-record per module invocation (scan_ui / UI workflow). Owns instance
	# metadata and result summary; links consumed/produced nuggets, the osint-service
	# that ran (service role), and the route under test (route role).
	#
	# API / UI parity (POST /api/v1/scan_ui scan_record):
	#   scan_instance_id   — SpiderFeet scan id (e.g. CFA30507)
	#   scan_status        — lifecycle: STARTING, FINISHED, ERROR-FAILED, …
	#   scan_duration      — seconds (started → ended)
	#   scan_timestamp     — scan start (datetime)
	#   scan_notes         — operator / UI notes
	#   scan_event_count   — total events in this scan instance
	#   scan_results_by_type — object map event_type → count (e.g. IP_ADDRESS: 2)
	#   scan_results       — bundled summary object { status, event_count, by_type }
	#   service (role)     — osint-service: module_id, name (e.g. sfp_dnsresolve)
	#   route (role)       — route: route_name, route_state (e.g. in-test)
	#   consumed / produced (roles) — nugget instances
	####################################

	relation scan-record,
		owns scan_instance_id,
		owns scan_status,
		owns scan_event_count,
		owns scan_results_by_type,
		owns scan_results,
		owns scan_duration,
		owns scan_timestamp,
		owns scan_notes,
		relates consumed @card(0..),
		relates produced @card(0..),
		relates service,
		relates route,
		plays enrichment:prior,
		plays enrichment:next;

	#####################################
	# SpiderFeet User-Initiated Enrichment, a Sequence of scan-records
	#
	# A user-initiated enrichment is a sequence of scan-records that are linked together by the enrichment_id.
	# The enrichment_id is a unique identifier for the enrichment.
	# The enrichment is a sequence of scan-records that are linked together by the enrichment_id.
	####################################

	relation enrichment,
		owns enrichment_id,
		owns stix_id,
		owns created,
		relates prior,
		relates next;


	#####################################
	# SpiderFeet Attribute Definitions
	# (only attributes referenced by owns on entity/relation types)
	####################################

	attribute route_state, value string @values("in-test", "favourite", "unique", "error", "dominated");
	attribute service_origin, value string @values("external-api", "cli", "local");
	attribute service_state, value string @values("quarantine", "in-test", "favourite", "unique", "error", "dominated");
	attribute fixture_category, value string @values("positive", "negative");
	attribute route_name, value string;
	attribute sequence_name, value string;
	attribute access_tier, value string @values("free_no_auth", "free_auth", "paid");
	attribute consumption_group, value string @values("domain", "hostname", "domain_and_hostname", "ip_netblock", "ip_only", "email", "email_identity_bundle", "phone", "crypto", "web_url_content", "org_entity", "other");
	attribute route_seed_nugget, value string;
	attribute module_id,  value string;
	attribute name,  value string;
	attribute summary, value string;
	attribute flags,  value string;
	attribute use_cases,  value string;
	attribute categories,  value string;
	attribute consumed_nuggets,  value string;
	attribute produced_nuggets,  value string;
	attribute website,  value string;
	attribute model,  value string;
	attribute references,  value string;
	attribute api_key_instructions,  value string;
	attribute fav_icon,  value string;
	attribute logo,  value string;
	attribute description,  value string;
	attribute nugget_id,  value string;
	attribute nugget_instance_id, value string;
	attribute nugget_description,  value string;
	attribute nugget_type,  value string;
	attribute nugget_event_type, value string;
	attribute nugget_icon,  value string;
	attribute nugget_colour,  value string;
	attribute nugget_data,  value string;
	attribute nugget_source_data, value string;
	attribute nugget_module, value string;
	attribute nugget_generated, value integer;
	attribute nugget_confidence, value integer;
	attribute nugget_visibility, value integer;
	attribute nugget_risk, value integer;
	attribute nugget_false_positive, value boolean;
	attribute opt_name, value string;
	attribute in_value, value integer;
	attribute db_value, value double;
	attribute bo_value, value boolean;
	attribute st_value, value string;
	attribute scan_instance_id, value string;
	attribute scan_status, value string @values("STARTING", "RUNNING", "FINISHED", "ERROR-FAILED", "ABORTED", "ABORT-REQUESTED", "UNKNOWN");
	attribute scan_event_count, value integer;
	attribute scan_results_by_type, value string;
	attribute scan_results, value string;
	attribute scan_duration, value double;
	attribute scan_timestamp, value datetime;
	attribute scan_notes, value string;
	attribute created, value datetime;
	attribute enrichment_id, value string;
	attribute stix_id, value string;