	#####################################
	# SpiderFeet OSINT Service Definitions
	####################################

	relation osint-service,
		owns module_id,
		owns name,
		owns summary,
		owns flags,
		owns use_cases,
		owns categories,
		owns fixture_category,
		owns access_tier,
		owns consumption_group,
		owns route_seed_nugget,
		owns consumed_nuggets,
		owns produced_nuggets,
		owns service_state,
		owns service_origin,
		plays scan-record:service,
		plays data-source:service,
		plays route:osint-service,
		plays opts:service,
		relates consumed @card(0..),
		relates produced @card(0..);

	entity osint-source,
		owns website,
		owns model,
		owns references,
		owns api_key_instructions,
		owns fav_icon,
		owns logo,
		owns description,
		plays data-source:source;

	entity module-opt,
		owns opt_name,
		owns in_value @card(0..1),
		owns db_value @card(0..1),
		owns bo_value @card(0..1),
		owns st_value @card(0..1),
		owns description @card(0..1),
		plays opts:opt;

	relation opts,
		relates service,
		relates opt;

	relation data-source,
		relates service,
		relates source;

	relation sfp-abstractapi, sub osint-service;
