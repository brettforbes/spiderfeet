	entity url-static-historic, sub nugget;  # Historic URL (Purely Static)
	entity url-upload, sub nugget;  # URL (Accepts Uploads)
	entity url-upload-historic, sub nugget;  # Historic URL (Accepts Uploads)
	entity url-web-framework, sub nugget;  # URL (Uses a Web Framework)
	entity url-web-framework-historic, sub nugget;  # Historic URL (Uses a Web Framework)
	entity vpn-host, sub nugget;  # VPN Host
	entity vulnerability-cve-critical, sub nugget;  # Vulnerability - CVE Critical
	entity vulnerability-cve-high, sub nugget;  # Vulnerability - CVE High
	entity vulnerability-cve-low, sub nugget;  # Vulnerability - CVE Low
	entity vulnerability-cve-medium, sub nugget;  # Vulnerability - CVE Medium
	entity vulnerability-disclosure, sub nugget;  # Vulnerability - Third Party Disclosure
