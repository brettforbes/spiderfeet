define

	# Naming convention (Option B):
	#   Entity and relation type labels: kebab-case (e.g. osint-service, domain-name)
	#   Attribute type labels: snake_case (e.g. access_tier, module_id)
	#   @values string literals: snake_case data values (e.g. free_no_auth, ip_netblock)

	####################################
	# SpiderFeet Nugget Definitions
	#
	####################################


	entity nugget @abstract,
		owns nugget_id, # nugget_id from the template in the .docs/analysis/nuggets.json
		owns nugget_instance_id @unique  @card(0..1), # (`nugget_instance_id` = `<nugget_id>--<UUI5(namespace, nugget_data)>`)
		owns nugget_description, # nugget_description from the template in the .docs/analysis/nuggets.json
		owns nugget_type, # nugget_type from the template in the .docs/analysis/nuggets.json
		owns nugget_event_type, # old event_type from the old scanning instance code, will be deprecated
		owns nugget_icon, # nugget_icon from the template in the .docs/analysis/nuggets.json
		owns nugget_colour, # nugget_colour from the template in the .docs/analysis/nuggets.json
		owns nugget_data, # nugget_data from the scanning instance
		owns nugget_source_data,
		owns nugget_module, # name of osint-service relation used to produce this nugget
		owns nugget_confidence, # confidence level of the nugget from the scanning instance
		plays osint-service:consumed,
		plays osint-service:produced,
		plays route:consumed,
		plays route:produced,
		plays scan-record:consumed,
		plays scan-record:produced,
		plays semantic_link:target,
		plays semantic_link:source;

	#
	# Semantic Relations
	relation semantic_link @abstract,
		relates source,
		relates target;

	relation has_this, sub semantic_link;
	relation contains_this, sub semantic_link;
	relation listens_to_this, sub semantic_link;

	#
	# Nugget Types
	entity category, sub nugget;
	entity entity_nugget, sub nugget;
	entity descriptor_nugget, sub nugget;
	entity data_nugget, sub nugget;
	entity subentity_nugget, sub nugget;
	entity root, sub nugget;
	entity null_value_nugget, sub nugget; # Signifies no result is expected or positive result from a negative fixture
	#
	# Actual Nugget Types (grouped by nugget_type from .docs/analysis/nuggets.json)
	#
	# Null Value Nuggets
	entity clean_miss, sub null_value_nugget; # Signfices positive result from a negative fixture
	entity no_input, sub null_value_nugget; # Signifies no input was provided
	#
	# Category Nuggets
	entity networks sub category;
	entity environment sub category;
	entity applications sub category;

	# Entity Nuggets
	# ENTITY - first-class investigation objects (hosts, domains, identities, etc.)
	# entity scan-record, sub entity_nugget; # Scan Record
	entity host, sub entity_nugget; # Host
	entity service, sub entity_nugget; # Network Service
	entity transport, sub entity_nugget; # Transport Protocol
	entity trace, sub entity_nugget; # Trace

	entity account-external-owned, sub nugget;  # Account on External Site
	entity affiliate-company-name, sub nugget;  # Affiliate - Company Name
	entity affiliate-domain-name, sub nugget;  # Affiliate - Domain Name
	entity affiliate-domain-unregistered, sub nugget;  # Affiliate - Domain Name Unregistered
	entity affiliate-emailaddr, sub nugget;  # Affiliate - Email Address
	entity affiliate-internet-name, sub nugget;  # Affiliate - Internet Name
	entity affiliate-internet-name-hijackable, sub nugget;  # Affiliate - Internet Name Hijackable
	entity affiliate-internet-name-unresolved, sub nugget;  # Affiliate - Internet Name - Unresolved
	entity affiliate-ipaddr, sub nugget;  # Affiliate - IP Address
	entity affiliate-ipv6-address, sub nugget;  # Affiliate - IPv6 Address
	entity appstore-entry, sub nugget;  # App Store Entry
	entity bgp-as-member, sub nugget;  # BGP AS Membership
	entity bgp-as-owner, sub nugget;  # BGP AS Ownership
	entity bitcoin-address, sub nugget;  # Bitcoin Address
	entity cloud-storage-bucket, sub nugget;  # Cloud Storage Bucket
	entity co-hosted-site, sub nugget;  # Co-Hosted Site
	entity co-hosted-site-domain, sub nugget;  # Co-Hosted Site - Domain Name
	entity company-name, sub nugget;  # Company Name
	entity country-name, sub nugget;  # Country Name
	entity credit-card-number, sub nugget;  # Credit Card Number
	entity date-human-dob, sub nugget;  # Date of Birth
	entity domain-name, sub nugget;  # Domain Name
	entity domain-name-parent, sub nugget;  # Domain Name (Parent)
	entity domain-registrar, sub nugget;  # Domain Registrar
	entity emailaddr, sub nugget;  # Email Address
	entity emailaddr-generic, sub nugget;  # Email Address - Generic
	entity ethereum-address, sub nugget;  # Ethereum Address
	entity human-name, sub nugget;  # Human Name
	entity iban-number, sub nugget;  # IBAN Number
	entity internal-ip-address, sub nugget;  # IP Address - Internal Network
	entity internet-name, sub nugget;  # Internet Name
	entity internet-name-unresolved, sub nugget;  # Internet Name - Unresolved
	entity ip-address, sub nugget;  # IP Address
	entity ipv6-address, sub nugget;  # IPv6 Address
	entity leaksite-url, sub nugget;  # Leak Site URL
	entity lei, sub nugget;  # Legal Entity Identifier
	entity netblock-member, sub nugget;  # Netblock Membership
	entity netblock-owner, sub nugget;  # Netblock Ownership
	entity netblockv6-member, sub nugget;  # Netblock IPv6 Membership
	entity netblockv6-owner, sub nugget;  # Netblock IPv6 Ownership
	entity phone-number, sub nugget;  # Phone Number
	entity physical-address, sub nugget;  # Physical Address
	entity physical-coordinates, sub nugget;  # Physical Coordinates
	entity provider-dns, sub nugget;  # Name Server (DNS NS Records)
	entity provider-hosting, sub nugget;  # Hosting Provider
	entity provider-javascript, sub nugget;  # Externally Hosted Javascript
	entity provider-mail, sub nugget;  # Email Gateway (DNS MX Records)
	entity provider-telco, sub nugget;  # Telecommunications Provider
	entity public-code-repo, sub nugget;  # Public Code Repository
	entity similar-account-external, sub nugget;  # Similar Account on External Site
	entity similardomain, sub nugget;  # Similar Domain
	entity social-media, sub nugget;  # Social Media Presence
	entity ssl-certificate-issued, sub nugget;  # SSL Certificate - Issued to
	entity ssl-certificate-issuer, sub nugget;  # SSL Certificate - Issued by
	entity username, sub nugget;  # Username
	entity web-analytics-id, sub nugget;  # Web Analytics
	entity wifi-access-point, sub nugget;  # WiFi Access Point Nearby

	# Descriptor Nuggets
	# DESCRIPTOR - attributes and classifications of entities
	entity scan-cli, sub descriptor_nugget; # Scan CLI
	entity scan-version, sub descriptor_nugget; # Scan Version
	entity scan-start, sub descriptor_nugget; # Scan Start
	entity scan-target, sub descriptor_nugget; # Scan Target
	entity scan-tool, sub descriptor_nugget; # Scan Tool
	entity scan-summary, sub descriptor_nugget; # Scan Summary
	entity scan-elapsed, sub descriptor_nugget; # Scan Elapsed Time
	entity host-status, sub descriptor_nugget; # Host Status
	entity host-status-reason, sub descriptor_nugget; # Host Status Reason
	entity port-state, sub descriptor_nugget; # Port State
	entity port-state-reason, sub descriptor_nugget; # Port State Reason
	entity port-protocol, sub descriptor_nugget; # Port Protocol
	entity service-extrainfo, sub descriptor_nugget; # Service Extra Information
	entity os-match-accuracy, sub descriptor_nugget; # OS Match Accuracy
	entity trace-protocol, sub descriptor_nugget; # Trace Protocol
	entity hop-ttl, sub descriptor_nugget; # Trace Hop TTL
	entity hop-rtt, sub descriptor_nugget; # Trace Hop RTT
	entity hop-order, sub descriptor_nugget; # Trace Hop Order
	entity ssh-key-bits, sub descriptor_nugget; # SSH Key Bits
	entity ssh-key-type, sub descriptor_nugget; # SSH Key Type
	entity ssh-key-key, sub descriptor_nugget; # SSH Public Key
	entity http-title, sub descriptor_nugget; # HTTP Title

	entity account-external-owned-compromised, sub nugget;  # Hacked Account on External Site
	entity account-external-user-shared-compromised, sub nugget;  # Hacked User Account on External Site
	entity affiliate-description-abstract, sub nugget;  # Affiliate Description - Abstract
	entity affiliate-description-category, sub nugget;  # Affiliate Description - Category
	entity bitcoin-balance, sub nugget;  # Bitcoin Balance
	entity blacklisted-affiliate-internet-name, sub nugget;  # Blacklisted Affiliate Internet Name
	entity blacklisted-affiliate-ipaddr, sub nugget;  # Blacklisted Affiliate IP Address
	entity blacklisted-cohost, sub nugget;  # Blacklisted Co-Hosted Site
	entity blacklisted-internet-name, sub nugget;  # Blacklisted Internet Name
	entity blacklisted-ipaddr, sub nugget;  # Blacklisted IP Address
	entity blacklisted-netblock, sub nugget;  # Blacklisted IP on Owned Netblock
	entity blacklisted-subnet, sub nugget;  # Blacklisted IP on Same Subnet
	entity cloud-storage-bucket-open, sub nugget;  # Cloud Storage Bucket Open
	entity darknet-mention-url, sub nugget;  # Darknet Mention URL
	entity defaced-affiliate-internet-name, sub nugget;  # Defaced Affiliate
	entity defaced-affiliate-ipaddr, sub nugget;  # Defaced Affiliate IP Address
	entity defaced-cohost, sub nugget;  # Defaced Co-Hosted Site
	entity defaced-internet-name, sub nugget;  # Defaced
	entity defaced-ipaddr, sub nugget;  # Defaced IP Address
	entity description-abstract, sub nugget;  # Description - Abstract
	entity description-category, sub nugget;  # Description - Category
	entity device-type, sub nugget;  # Device Type
	entity emailaddr-compromised, sub nugget;  # Hacked Email Address
	entity emailaddr-deliverable, sub nugget;  # Deliverable Email Address
	entity emailaddr-disposable, sub nugget;  # Disposable Email Address
	entity emailaddr-undeliverable, sub nugget;  # Undeliverable Email Address
	entity ethereum-balance, sub nugget;  # Ethereum Balance
	entity geoinfo, sub nugget;  # Physical Location
	entity interesting-file, sub nugget;  # Interesting File
	entity interesting-file-historic, sub nugget;  # Historic Interesting File
	entity job-title, sub nugget;  # Job Title
	entity junk-file, sub nugget;  # Junk File
	entity malicious-affiliate-internet-name, sub nugget;  # Malicious Affiliate
	entity malicious-affiliate-ipaddr, sub nugget;  # Malicious Affiliate IP Address
	entity malicious-asn, sub nugget;  # Malicious AS
	entity malicious-bitcoin-address, sub nugget;  # Malicious Bitcoin Address
	entity malicious-cohost, sub nugget;  # Malicious Co-Hosted Site
	entity malicious-emailaddr, sub nugget;  # Malicious E-mail Address
	entity malicious-internet-name, sub nugget;  # Malicious Internet Name
	entity malicious-ipaddr, sub nugget;  # Malicious IP Address
	entity malicious-netblock, sub nugget;  # Malicious IP on Owned Netblock
	entity malicious-phone-number, sub nugget;  # Malicious Phone Number
	entity malicious-subnet, sub nugget;  # Malicious IP on Same Subnet
	entity operating-system, sub nugget;  # Operating System
