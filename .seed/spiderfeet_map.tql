	entity ssl-certificate-expiring, sub nugget;  # SSL Certificate Expiring
	entity ssl-certificate-mismatch, sub nugget;  # SSL Certificate Host Mismatch
	entity target-web-content-type, sub nugget;  # Web Content Type
	entity tor-exit-node, sub nugget;  # TOR Exit Node
	entity url-adblocked-external, sub nugget;  # URL (AdBlocked External)
	entity url-adblocked-internal, sub nugget;  # URL (AdBlocked Internal)
	entity url-flash, sub nugget;  # URL (Uses Flash)
