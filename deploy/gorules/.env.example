# Copy to deploy/gorules/.env. Never commit the copy.
# Obtain LICENSE_KEY from https://portal.gorules.io before expecting BRMS to become healthy.
# Generate the three secrets with: openssl rand -hex 32

DB_USER=gorules
DB_PASSWORD=replace-with-local-password
DB_NAME=gorules
LICENSE_KEY=
COOKIE_SECRET=replace-with-32-byte-hex
HASH_SECRET=replace-with-32-byte-hex
RELEASE_ZIP_PASSWORD=replace-with-local-password
BRMS_HOST_PORT=8088
