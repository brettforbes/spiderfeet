{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiderfeet.local/schemas/workflow_v1.schema.json",
  "title": "SpiderFeet Workflow DSL v1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "info",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "spiderfeet.workflow/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "id": {
      "type": "string",
      "pattern": "^workflow--[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "info": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "string_list"
          },
          "description": {
            "type": "string"
          },
          "default": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Canonical 12A seed list (alias of default)"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "id",
        "uses",
        "input",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uses": {
          "type": "string",
          "pattern": "^tool\\.[a-z][a-z0-9_]*$"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "from"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "string_list"
                },
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "normalize": {
                  "enum": [
                    "hostname_from_url",
                    "none"
                  ]
                },
                "empty": {
                  "enum": [
                    "error",
                    "skip_step",
                    "continue"
                  ],
                  "default": "error"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "none"
                }
              }
            }
          ]
        },
        "config": {
          "type": "object",
          "required": [
            "argv",
            "files",
            "capture"
          ],
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Per-batch or single-run wall-clock seconds for module execution (overrides module default)."
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "files": {
              "type": "object",
              "required": [
                "output"
              ],
              "additionalProperties": false,
              "properties": {
                "input": {
                  "$ref": "#/$defs/fileSpec"
                },
                "output": {
                  "$ref": "#/$defs/fileSpec"
                }
              }
            },
            "capture": {
              "type": "object",
              "required": [
                "family",
                "adapter"
              ],
              "additionalProperties": false,
              "properties": {
                "family": {
                  "enum": [
                    "structured_native",
                    "validated_scan_json",
                    "json_bundle",
                    "text_only"
                  ]
                },
                "adapter": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "overall_timeout": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Step wall-clock cap in seconds (e.g. Nuclei multi-batch runs)."
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vars": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "null"
                },
                {
                  "const": "none"
                }
              ]
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "export": {
              "enum": [
                "scan_graph",
                "none"
              ]
            }
          }
        }
      }
    },
    "fileSpec": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "none",
            "path"
          ]
        },
        "format": {
          "enum": [
            "line_text",
            "jsonl",
            "json",
            "xml"
          ]
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
